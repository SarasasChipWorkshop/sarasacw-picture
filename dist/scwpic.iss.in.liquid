; Inno Setup script for the Windows installer of SCW Photo Viewer.
;
;   ISCC.exe /DPublishDir=<publish-dir> /DOutputDir=<dist-dir> path\to\this.iss
;

#ifndef PublishDir
#error PublishDir must be specified when running this script. It specifies the directory from which Inno Setup retrieves the artifacts to be packaged.
#endif
#ifndef OutputDir
#error OutputDir must be specified when running this script. It specifies the directory in which Inno Setup writes the generated setup package.
#endif

#define MyAppName "SCW Photo Viewer"
#define MyAppVersion "@PROJECT_VERSION@"
#define MyAppPublisher "Sarasa's Chip Workshop"
#define MyAppURL "https://github.com/SarasasChipWorkshop/sarasacw-picture"
#define MyAppExeName "scwpic.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
{% comment %}
The escaped double opening brace in the AppId value below is wrapped in a Liquid raw block, 
because it would otherwise open a Liquid output tag.
{% endcomment %}
AppId={% raw %}{{A90F12B1-1BD5-4816-994B-A3E95CCFF24E}{% endraw %}
AppName={cm:MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
; Explicit literals (via preprocessor defines): the Setup.exe version info resource
; must not fall back to AppName, because AppName carries an Inno constant and the
; fallback yields an empty string in that case.
VersionInfoDescription={#MyAppName} Setup
VersionInfoProductName={#MyAppName}
DefaultDirName={autopf}\sarasacw-picture
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
ChangesAssociations=yes
DefaultGroupName={cm:MyAppName}
AllowNoIcons=yes
LicenseFile={#PublishDir}\LICENSE
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir={#OutputDir}
OutputBaseFilename=scwpic-setup
SolidCompression=yes
WizardStyle=modern

[Languages]
{% comment %}
YYC MARK:
The base messages file pairing (the official full translation that provides
the language identity) is derived from MetaGlot's best-effort conversion of
the PO language tag to the conventional Inno Setup language name (lang.lang)
and its officiality (lang.is_official). A language without an official base
file - a community provided conventional name, or a language unknown to
MetaGlot which converts to nothing - is dropped instead of falling back:
every [Languages] entry inherits the language identity of its base file, and
"compiler:Default.isl" carries the English identity, so a fallback entry
would flood the setup language selection dialog with duplicate English
items. To keep such a language, ship its base messages file with the
installer and pair it explicitly (e.g. via a "case" on "lang.name"). The
incremental custom messages file is named after the conventional name; keep
it in sync with the "--isl-path" argument in CMakeLists.txt. The path
rendering loop is independent of the dropping decision, so a dropped
language still gets an (unreferenced) messages file written.
{% endcomment -%}
{% for lang in langs -%}
{%- if lang.is_official -%}
{%- if lang.lang == 'Default' -%}
{% assign base = 'compiler:Default.isl' -%}
{%- else -%}
{% assign base = 'compiler:Languages\' | append: lang.lang | append: '.isl' -%}
{%- endif -%}
Name: "{{ lang.name }}"; MessagesFile: "{{ base }},Strings\{{ lang.lang }}.isl"
{% else -%}
{%- comment -%}
unofficial or unmapped: dropped, since a Default.isl fallback would duplicate the English identity in the Select Language dialog
{%- endcomment -%}
{% endif -%}
{% endfor -%}

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "associatewithfiles"; Description: "{cm:MyAssociateWithFiles,{#MyAppName}}"; GroupDescription: "{cm:MyOther}"

[Files]
; YYC MARK:
; This script is compiled in place and retrieves the artifacts to be packaged
; from the directory given by the "PublishDir" define, which must contain
; "scwpic.exe" and the "LICENSE" file. Otherwise exception will be thrown.
Source: "{#PublishDir}\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#PublishDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Registry]
; Registration scheme follows the app-registration model (App Paths + Applications
; keys plus per-family ProgIds), with all display names and icons referenced as
; indirect strings into scwpic.exe itself (string table 1000-1028, icons 101-105),
; so the registry values stay language-neutral and Explorer resolves them per
; user UI language. Adding a new file family: copy a family block below, adjust
; the ProgId, string ID, icon ID and extension list, then add the extensions to
; SupportedTypes. String/icon IDs must exist in the Windows RC resources
; (dist/sarasacw-picture.rc.in.toml and dist/winrc-icos).

; --- Application registration (always installed) ---

; App Paths: lets the shell resolve "scwpic.exe" by name and locates its DLL directory.
Root: HKA; Subkey: "Software\Microsoft\Windows\CurrentVersion\App Paths\scwpic.exe"; ValueType: string; ValueName: ""; ValueData: "{app}\scwpic.exe"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Microsoft\Windows\CurrentVersion\App Paths\scwpic.exe"; ValueType: string; ValueName: "Path"; ValueData: "{app}"
; Applications: makes scwpic.exe itself appear in the "Open with" lists.
Root: HKA; Subkey: "Software\Classes\Applications\scwpic.exe"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "@{app}\scwpic.exe,-1000"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\Applications\scwpic.exe"; ValueType: string; ValueName: "NoOpenWith"; ValueData: ""
Root: HKA; Subkey: "Software\Classes\Applications\scwpic.exe\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\scwpic.exe,-101"
Root: HKA; Subkey: "Software\Classes\Applications\scwpic.exe\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\scwpic.exe"" ""%1"""
